# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-2  # must match the Snowflake account region
S3_BUCKET_NAME=insurance-de-platform-dev

# ── Snowflake ────────────────────────────────────────────────────────────────
# Objects come from snowflake/setup.sql. Auth is key-pair: the private key
# file lives outside the repo (see snowflake/README.md). No password here.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=PIPELINE_SVC
# Absolute path: dbt opens it as written and does not expand ~
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/YOUR_USER/.snowflake/keys/pipeline_svc.p8
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING_WH
SNOWFLAKE_DATABASE=INSURANCE_PLATFORM
SNOWFLAKE_SCHEMA=RAW
# The loader uses these instead of ROLE/WAREHOUSE above.
SNOWFLAKE_LOADER_ROLE=LOADER
SNOWFLAKE_LOADER_WAREHOUSE=LOADING_WH

# ── dbt ──────────────────────────────────────────────────────────────────────
# Absolute path: a relative one breaks when dbt runs from inside dbt_project/
# (the VS Code dbt extension does), resolving to dbt_project/dbt_project.
DBT_PROFILES_DIR=/absolute/path/to/insurance-de-platform/dbt_project
DBT_TARGET=dev

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///./airflow/airflow.db

# ── Generator ────────────────────────────────────────────────────────────────
GENERATOR_SEED=42
GENERATOR_OUTPUT_PATH=./data/raw
